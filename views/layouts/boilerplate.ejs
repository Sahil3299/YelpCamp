<!DOCTYPE html>
<html lang="en" data-theme="light">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <meta name="description" content="YelpCamp - Discover and share the best campgrounds around the world">
    <meta name="theme-color" content="#ffffff">
    <title>YelpCamp - Discover Amazing Campgrounds</title>

    <!-- Bootstrap 5.3 CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
        integrity="sha384-9ndCyUaIbzAi2FUarbnLuTLV3H3dWt4pJnicqX/j0NYtSuA+V5vdc6QWmN+cVzn5Z" crossorigin="anonymous">
    
    <!-- Font Awesome (self-hosted for reliable icon rendering) -->
    <link rel="stylesheet" href="/vendor/fontawesome/css/all.min.css">

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <!-- Google Fonts - premium editorial + clean UI pairing -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Playfair+Display:wght@600;700;800&family=Poppins:wght@500;600;700&display=swap" rel="stylesheet">

    <!-- Custom CSS -->
    <link rel="stylesheet" href="/stylesheets/theme.css">
    <link rel="stylesheet" href="/stylesheets/components.css">
    <link rel="stylesheet" href="/stylesheets/animations.css">
    <link rel="stylesheet" href="/stylesheets/app.css">
    <link rel="stylesheet" href="/stylesheets/accessibility.css">
    <link rel="stylesheet" href="/stylesheets/responsive.css">
</head>

<body class="d-flex flex-column">
    <!-- Skip to main content link for accessibility -->
    <a href="#main-content" class="skip-link">Skip to main content</a>
    
    <%- include('../partials/navbar')%>
    <main class="main-content flex-grow-1" id="main-content">
        <div class="container-lg">
            <%- include('../partials/flash')%>
            <%- body %>
        </div>
    </main>
    <%- include('../partials/footer')%>

    <!-- Popper JS -->
    <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.8/dist/umd/popper.min.js"
        integrity="sha384-I7E8VVD/ismYTF4hNIPjVp/Zjvgyou6Cd4S0vJfvmZgpX5bE+hVlJ5fTbXrPEFn0"
        crossorigin="anonymous"></script>
    
    <!-- Bootstrap 5.3 JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.min.js"
        integrity="sha384-fbbOQedDnW4V7XnOnxeWqWLVnFjlWM6DVUj34lIEsLEkD0B5S4Mq93aITmJ/g3IAo" crossorigin="anonymous"></script>

    <!-- Form Validation -->
    <script src='/javascripts/validateForms.js'></script>
    
    <!-- Custom Animations & Interactions -->
    <script src='/javascripts/animations.js'></script>
    
    <!-- Theme Toggle -->
    <script src='/javascripts/theme.js'></script>
</body>

</html>

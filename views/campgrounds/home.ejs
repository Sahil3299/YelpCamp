<% layout('layouts/boilerplate')%>

<!-- Hero Section -->
<section class="hero home-hero" style="background-image: url('https://images.unsplash.com/photo-1504851149312-7a075b496cc7?auto=format&fit=crop&w=1800&q=80')">
    <div class="hero-content">
        <p class="hero-kicker">A community for outdoor people</p>
        <h1 class="hero-title">Find your <em>next wild</em> place.</h1>
        <p class="hero-subtitle">Discover and share extraordinary campgrounds across India, from Himalayan ridges to quiet beaches and desert skies.</p>
        <div class="hero-buttons">
            <a href="/campgrounds" class="btn btn-primary btn-lg">
                Start Your Adventure <i class="fas fa-arrow-right ms-2"></i>
            </a>
            <a href="/register" class="btn btn-outline-light btn-lg">
                Explore Campgrounds
            </a>
        </div>
    </div>
</section>

<!-- Featured Campgrounds Section -->
<section class="section bg-light">
    <div class="container-lg">
        <h2 class="section-title">Featured Campgrounds</h2>
        <div class="section-divider"></div>
        <p class="section-subtitle">Explore handpicked Indian campgrounds from our community</p>
        
        <div class="grid-cards mt-5">
            <div class="campground-card stagger-item hover-lift">
                <div class="campground-card-image image-hover-overlay">
                    <img src="https://images.unsplash.com/photo-1500530855697-b586d89ba3ee?w=500" alt="Rishikesh Riverside Camp" class="w-100 h-100" style="object-fit: cover;">
                    <span class="campground-card-badge">Popular</span>
                </div>
                <div class="campground-card-body">
                    <h5 class="campground-card-title">Rishikesh Riverside Camp</h5>
                    <p class="campground-card-description">Rafting, riverside tents, bonfire evenings, and Himalayan foothill views near the Ganga.</p>
                    <div class="campground-card-location">
                        <i class="fas fa-map-marker-alt"></i>
                        <span>Uttarakhand, India</span>
                    </div>
                    <div class="campground-card-footer">
                        <div>
                            <div class="campground-card-price">Rs. 2200<small>/night</small></div>
                        </div>
                        <a href="/campgrounds" class="btn btn-primary btn-sm campground-card-btn">View</a>
                    </div>
                </div>
            </div>

            <div class="campground-card stagger-item hover-lift">
                <div class="campground-card-image image-hover-overlay">
                    <img src="https://images.unsplash.com/photo-1478131143081-80f7f84ca84d?w=500" alt="Tirthan Valley Pine Camp" class="w-100 h-100" style="object-fit: cover;">
                    <span class="campground-card-badge">New</span>
                </div>
                <div class="campground-card-body">
                    <h5 class="campground-card-title">Tirthan Valley Pine Camp</h5>
                    <p class="campground-card-description">A quiet pine forest base for river walks, trout fishing, birding, and village trails.</p>
                    <div class="campground-card-location">
                        <i class="fas fa-map-marker-alt"></i>
                        <span>Himachal Pradesh, India</span>
                    </div>
                    <div class="campground-card-footer">
                        <div>
                            <div class="campground-card-price">Rs. 2800<small>/night</small></div>
                        </div>
                        <a href="/campgrounds" class="btn btn-primary btn-sm campground-card-btn">View</a>
                    </div>
                </div>
            </div>

            <div class="campground-card stagger-item hover-lift">
                <div class="campground-card-image image-hover-overlay">
                    <img src="https://images.unsplash.com/photo-1509316785289-025f5b846b35?w=500" alt="Jaisalmer Dune Safari Camp" class="w-100 h-100" style="object-fit: cover;">
                    <span class="campground-card-badge">Best Rated</span>
                </div>
                <div class="campground-card-body">
                    <h5 class="campground-card-title">Jaisalmer Dune Safari Camp</h5>
                    <p class="campground-card-description">Canvas tents, camel trails, folk music nights, and sunset views over the Thar.</p>
                    <div class="campground-card-location">
                        <i class="fas fa-map-marker-alt"></i>
                        <span>Rajasthan, India</span>
                    </div>
                    <div class="campground-card-footer">
                        <div>
                            <div class="campground-card-price">Rs. 4200<small>/night</small></div>
                        </div>
                        <a href="/campgrounds" class="btn btn-primary btn-sm campground-card-btn">View</a>
                    </div>
                </div>
            </div>

            <div class="campground-card stagger-item hover-lift">
                <div class="campground-card-image image-hover-overlay">
                    <img src="https://images.unsplash.com/photo-1502082553048-f009c37129b9?w=500" alt="Coorg Coffee Estate Camp" class="w-100 h-100" style="object-fit: cover;">
                    <span class="campground-card-badge">Adventure</span>
                </div>
                <div class="campground-card-body">
                    <h5 class="campground-card-title">Coorg Coffee Estate Camp</h5>
                    <p class="campground-card-description">Misty plantation trails, local meals, bonfire seating, and peaceful estate views.</p>
                    <div class="campground-card-location">
                        <i class="fas fa-map-marker-alt"></i>
                        <span>Karnataka, India</span>
                    </div>
                    <div class="campground-card-footer">
                        <div>
                            <div class="campground-card-price">Rs. 3200<small>/night</small></div>
                        </div>
                        <a href="/campgrounds" class="btn btn-primary btn-sm campground-card-btn">View</a>
                    </div>
                </div>
            </div>

            <div class="campground-card stagger-item hover-lift">
                <div class="campground-card-image image-hover-overlay">
                    <img src="https://images.unsplash.com/photo-1507525428034-b723cf961d3e?w=500" alt="Andaman Beachfront Camp" class="w-100 h-100" style="object-fit: cover;">
                    <span class="campground-card-badge">Relaxing</span>
                </div>
                <div class="campground-card-body">
                    <h5 class="campground-card-title">Andaman Beachfront Camp</h5>
                    <p class="campground-card-description">Island tents near turquoise water with snorkeling, kayaking, and slow beach evenings.</p>
                    <div class="campground-card-location">
                        <i class="fas fa-map-marker-alt"></i>
                        <span>Andaman and Nicobar Islands, India</span>
                    </div>
                    <div class="campground-card-footer">
                        <div>
                            <div class="campground-card-price">Rs. 5200<small>/night</small></div>
                        </div>
                        <a href="/campgrounds" class="btn btn-primary btn-sm campground-card-btn">View</a>
                    </div>
                </div>
            </div>

            <div class="campground-card stagger-item hover-lift">
                <div class="campground-card-image image-hover-overlay">
                    <img src="https://images.unsplash.com/photo-1464822759023-fed622ff2c3b?w=500" alt="Ladakh Nubra Valley Camp" class="w-100 h-100" style="object-fit: cover;">
                    <span class="campground-card-badge">Scenic</span>
                </div>
                <div class="campground-card-body">
                    <h5 class="campground-card-title">Ladakh Nubra Valley Camp</h5>
                    <p class="campground-card-description">Cold desert camping with dunes, monasteries, poplar groves, and stargazing nights.</p>
                    <div class="campground-card-location">
                        <i class="fas fa-map-marker-alt"></i>
                        <span>Ladakh, India</span>
                    </div>
                    <div class="campground-card-footer">
                        <div>
                            <div class="campground-card-price">Rs. 4800<small>/night</small></div>
                        </div>
                        <a href="/campgrounds" class="btn btn-primary btn-sm campground-card-btn">View</a>
                    </div>
                </div>
            </div>
        </div>

        <div class="text-center mt-5">
            <a href="/campgrounds" class="btn btn-primary btn-lg">
                <i class="fas fa-arrow-right me-2"></i>View All Campgrounds
            </a>
        </div>
    </div>
</section>

<!-- Features Section -->
<section class="section">
    <div class="container-lg">
        <h2 class="section-title">Why Choose YelpCamp?</h2>
        <div class="section-divider"></div>
        <p class="section-subtitle">Everything you need for your camping adventure</p>

        <div class="grid-cards mt-5">
            <div class="card stagger-item hover-shadow">
                <div class="card-body text-center py-4">
                    <div class="mb-3">
                        <i class="fas fa-map-location-dot fa-3x text-primary"></i>
                    </div>
                    <h5 class="card-title">Discover Locations</h5>
                    <p class="card-text">Find campgrounds across India with detailed information and user reviews.</p>
                </div>
            </div>

            <div class="card stagger-item hover-shadow">
                <div class="card-body text-center py-4">
                    <div class="mb-3">
                        <i class="fas fa-star fa-3x text-warning"></i>
                    </div>
                    <h5 class="card-title">Read Reviews</h5>
                    <p class="card-text">Get honest reviews from real campers to help you make the best choice.</p>
                </div>
            </div>

            <div class="card stagger-item hover-shadow">
                <div class="card-body text-center py-4">
                    <div class="mb-3">
                        <i class="fas fa-pen-fancy fa-3x text-success"></i>
                    </div>
                    <h5 class="card-title">Share Experience</h5>
                    <p class="card-text">Submit your favorite campgrounds and help other travelers find their perfect spot.</p>
                </div>
            </div>

            <div class="card stagger-item hover-shadow">
                <div class="card-body text-center py-4">
                    <div class="mb-3">
                        <i class="fas fa-shield-halved fa-3x text-info"></i>
                    </div>
                    <h5 class="card-title">Trusted Community</h5>
                    <p class="card-text">Join thousands of outdoor enthusiasts sharing their camping experiences.</p>
                </div>
            </div>
        </div>
    </div>
</section>


<% layout('layouts/boilerplate')%>
<link rel="stylesheet" href="/stylesheets/home.css">

<!-- Hero Section -->
<section class="hero home-hero" style="background-image: url('/images/yelpcamp.png')">
    <div class="home-hero-inner">
        <div class="home-brand">
            <span class="home-brand-icon" aria-hidden="true">
                <i class="bi bi-signpost-2-fill"></i>
            </span>
            <div>
                <h2 class="home-brand-name">YelpCamp</h2>
                <p class="home-brand-tagline">Find Your Next Adventure</p>
            </div>
        </div>

        <div class="home-hero-content">
            <h1 class="home-headline">
                <span class="home-headline-line">Find. Explore.</span>
                <span class="home-headline-line home-headline-accent">Camp. Review.</span>
            </h1>
            <p class="home-subtitle">Discover and review amazing campgrounds around the world.</p>
            <a href="/campgrounds" class="btn btn-success btn-lg home-cta">
                Explore Campgrounds <i class="bi bi-arrow-right ms-2"></i>
            </a>
        </div>

        <div class="home-features" role="list">
            <div class="home-feature" role="listitem">
                <span class="home-feature-icon" aria-hidden="true"><i class="bi bi-search"></i></span>
                <div>
                    <h3 class="home-feature-title">Browse Campgrounds</h3>
                    <p class="home-feature-text">Explore hundreds of campgrounds with details, photos, and locations.</p>
                </div>
            </div>
            <div class="home-feature" role="listitem">
                <span class="home-feature-icon" aria-hidden="true"><i class="bi bi-pencil-fill"></i></span>
                <div>
                    <h3 class="home-feature-title">Add Your Campground</h3>
                    <p class="home-feature-text">Share your favorite camping spots with the community.</p>
                </div>
            </div>
            <div class="home-feature" role="listitem">
                <span class="home-feature-icon" aria-hidden="true"><i class="bi bi-star"></i></span>
                <div>
                    <h3 class="home-feature-title">Write Reviews</h3>
                    <p class="home-feature-text">Rate and review campgrounds to help fellow campers.</p>
                </div>
            </div>
            <div class="home-feature" role="listitem">
                <span class="home-feature-icon" aria-hidden="true"><i class="bi bi-geo-alt-fill"></i></span>
                <div>
                    <h3 class="home-feature-title">Interactive Maps</h3>
                    <p class="home-feature-text">View campgrounds on interactive maps and find spots near you.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Featured Campgrounds Section -->
<section class="section bg-light">
    <div class="container-lg">
        <h2 class="section-title">Featured Campgrounds</h2>
        <div class="section-divider"></div>
        <p class="section-subtitle">Explore handpicked campgrounds from our community</p>
        
        <div class="grid-cards mt-5">
            <div class="campground-card stagger-item hover-lift">
                <div class="campground-card-image image-hover-overlay">
                    <img src="https://images.unsplash.com/photo-1500530855697-b586d89ba3ee?w=500" alt="Rishikesh Riverside Camp" class="w-100 h-100" style="object-fit: cover;">
                    <span class="campground-card-badge">Popular</span>
                </div>
                <div class="campground-card-body">
                    <h5 class="campground-card-title">Rishikesh Riverside Camp</h5>
                    <p class="campground-card-description">Rafting, riverside tents, bonfire evenings, and Himalayan foothill views near the Ganga.</p>
                    <div class="campground-card-location">
                        <i class="bi bi-geo-alt-fill"></i>
                        <span>Uttarakhand, India</span>
                    </div>
                    <div class="campground-card-footer">
                        <div>
                            <div class="campground-card-price">Rs. 2200<small>/night</small></div>
                        </div>
                        <a href="/campgrounds" class="btn btn-primary btn-sm campground-card-btn">View</a>
                    </div>
                </div>
            </div>

            <div class="campground-card stagger-item hover-lift">
                <div class="campground-card-image image-hover-overlay">
                    <img src="https://images.unsplash.com/photo-1478131143081-80f7f84ca84d?w=500" alt="Tirthan Valley Pine Camp" class="w-100 h-100" style="object-fit: cover;">
                    <span class="campground-card-badge">New</span>
                </div>
                <div class="campground-card-body">
                    <h5 class="campground-card-title">Tirthan Valley Pine Camp</h5>
                    <p class="campground-card-description">A quiet pine forest base for river walks, trout fishing, birding, and village trails.</p>
                    <div class="campground-card-location">
                        <i class="bi bi-geo-alt-fill"></i>
                        <span>Himachal Pradesh, India</span>
                    </div>
                    <div class="campground-card-footer">
                        <div>
                            <div class="campground-card-price">Rs. 2800<small>/night</small></div>
                        </div>
                        <a href="/campgrounds" class="btn btn-primary btn-sm campground-card-btn">View</a>
                    </div>
                </div>
            </div>

            <div class="campground-card stagger-item hover-lift">
                <div class="campground-card-image image-hover-overlay">
                    <img src="https://images.unsplash.com/photo-1509316785289-025f5b846b35?w=500" alt="Jaisalmer Dune Safari Camp" class="w-100 h-100" style="object-fit: cover;">
                    <span class="campground-card-badge">Best Rated</span>
                </div>
                <div class="campground-card-body">
                    <h5 class="campground-card-title">Jaisalmer Dune Safari Camp</h5>
                    <p class="campground-card-description">Canvas tents, camel trails, folk music nights, and sunset views over the Thar.</p>
                    <div class="campground-card-location">
                        <i class="bi bi-geo-alt-fill"></i>
                        <span>Rajasthan, India</span>
                    </div>
                    <div class="campground-card-footer">
                        <div>
                            <div class="campground-card-price">Rs. 4200<small>/night</small></div>
                        </div>
                        <a href="/campgrounds" class="btn btn-primary btn-sm campground-card-btn">View</a>
                    </div>
                </div>
            </div>

            <div class="campground-card stagger-item hover-lift">
                <div class="campground-card-image image-hover-overlay">
                    <img src="https://images.unsplash.com/photo-1502082553048-f009c37129b9?w=500" alt="Coorg Coffee Estate Camp" class="w-100 h-100" style="object-fit: cover;">
                    <span class="campground-card-badge">Adventure</span>
                </div>
                <div class="campground-card-body">
                    <h5 class="campground-card-title">Coorg Coffee Estate Camp</h5>
                    <p class="campground-card-description">Misty plantation trails, local meals, bonfire seating, and peaceful estate views.</p>
                    <div class="campground-card-location">
                        <i class="bi bi-geo-alt-fill"></i>
                        <span>Karnataka, India</span>
                    </div>
                    <div class="campground-card-footer">
                        <div>
                            <div class="campground-card-price">Rs. 3200<small>/night</small></div>
                        </div>
                        <a href="/campgrounds" class="btn btn-primary btn-sm campground-card-btn">View</a>
                    </div>
                </div>
            </div>
        </div>

        <div class="text-center mt-5">
            <a href="/campgrounds" class="btn btn-primary btn-lg">
                <i class="bi bi-arrow-right me-2"></i>View All Campgrounds
            </a>
        </div>
    </div>
</section>

<!-- CTA Section -->
<section class="section bg-primary text-white">
    <div class="container-lg text-center">
        <h2 class="section-title text-white mb-3">Ready for Your Next Adventure?</h2>
        <p class="section-subtitle text-white mb-4">Join campers exploring the most memorable outdoor stays</p>
        <div class="d-flex gap-3 justify-content-center flex-wrap">
            <a href="/campgrounds" class="btn btn-light btn-lg">
                <i class="bi bi-search me-2"></i>Browse Campgrounds
            </a>
            <a href="/register" class="btn btn-outline-light btn-lg">
                <i class="bi bi-person-plus me-2"></i>Join Today
            </a>
        </div>
    </div>
</section>

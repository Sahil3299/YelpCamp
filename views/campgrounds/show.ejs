<% layout('layouts/boilerplate')%>
<link rel="stylesheet" href="/stylesheets/stars.css">

<!-- Breadcrumb Navigation -->
<nav class="breadcrumb-custom mb-4">
    <a href="/" class="breadcrumb-custom-item link-hover-underline">
        <i class="fas fa-home me-1"></i>Home
    </a>
    <span class="breadcrumb-custom-sep">
        <i class="fas fa-chevron-right"></i>
    </span>
    <a href="/campgrounds" class="breadcrumb-custom-item link-hover-underline">
        <i class="fas fa-map-marked-alt me-1"></i>Campgrounds
    </a>
    <span class="breadcrumb-custom-sep">
        <i class="fas fa-chevron-right"></i>
    </span>
    <span class="breadcrumb-custom-item active"><%= campground.title %></span>
</nav>

<div class="row g-4 mb-5">
    <!-- Left Column - Images and Details -->
    <div class="col-lg-7">
        <!-- Modern Image Carousel -->
        <% const galleryImages = [campground.image, ...((campground.images || []))].filter(Boolean).filter((img, index, arr) => arr.indexOf(img) === index); %>
        <div id="campgroundCarousel" class="campground-carousel-container mb-4" role="region" aria-label="Campground images carousel">
            <div class="carousel-wrapper" data-total-images="<%= galleryImages.length %>">
                <div class="carousel-main">
                    <% galleryImages.forEach((img, index) => { %>
                    <div class="carousel-slide <%= index === 0 ? 'active' : '' %>" data-slide-index="<%= index %>">
                        <img src="<%= img %>" alt="<%= campground.title %> image <%= index + 1 %>" class="carousel-image" loading="lazy">
                        <div class="carousel-slide-overlay"></div>
                    </div>
                    <% }) %>
                </div>

                <!-- Image Counter -->
                <div class="carousel-counter" aria-live="polite" aria-atomic="true">
                    <span class="counter-current">1</span> / <span class="counter-total"><%= galleryImages.length %></span>
                </div>

                <!-- Navigation Arrows -->
                <% if(galleryImages.length > 1) { %>
                <button class="carousel-nav-btn carousel-prev" aria-label="Previous image" title="Previous (← key)">
                    <i class="fas fa-chevron-left"></i>
                </button>
                <button class="carousel-nav-btn carousel-next" aria-label="Next image" title="Next (→ key)">
                    <i class="fas fa-chevron-right"></i>
                </button>
                <% } %>

                <!-- Image Indicators -->
                <% if(galleryImages.length > 1) { %>
                <div class="carousel-indicators-container">
                    <% galleryImages.forEach((img, index) => { %>
                    <button class="carousel-indicator <%= index === 0 ? 'active' : '' %>" 
                            data-slide-to="<%= index %>" 
                            aria-label="Go to image <%= index + 1 %>"
                            aria-current="<%= index === 0 ? 'true' : 'false' %>"></button>
                    <% }) %>
                </div>
                <% } %>
            </div>
        </div>

        <script>
            // Modern Carousel Implementation
            (function() {
                const carouselContainer = document.getElementById('campgroundCarousel');
                if (!carouselContainer) return;

                const wrapper = carouselContainer.querySelector('.carousel-wrapper');
                const slides = carouselContainer.querySelectorAll('.carousel-slide');
                const indicators = carouselContainer.querySelectorAll('.carousel-indicator');
                const prevBtn = carouselContainer.querySelector('.carousel-prev');
                const nextBtn = carouselContainer.querySelector('.carousel-next');
                const counterCurrent = carouselContainer.querySelector('.counter-current');
                const totalImages = slides.length;

                let currentIndex = 0;
                let touchStartX = 0;
                let touchEndX = 0;
                let autoPlayTimeout;

                // Update carousel display
                function updateCarousel(newIndex) {
                    // Handle wrap-around
                    if (newIndex >= totalImages) newIndex = 0;
                    if (newIndex < 0) newIndex = totalImages - 1;

                    currentIndex = newIndex;

                    // Update slides with fade transition
                    slides.forEach((slide, index) => {
                        slide.classList.remove('active');
                        if (index === newIndex) {
                            slide.classList.add('active');
                        }
                    });

                    // Update indicators
                    indicators.forEach((indicator, index) => {
                        indicator.classList.toggle('active', index === newIndex);
                        indicator.setAttribute('aria-current', index === newIndex ? 'true' : 'false');
                    });

                    // Update counter
                    counterCurrent.textContent = newIndex + 1;

                    // Reset auto-play
                    clearTimeout(autoPlayTimeout);
                    autoPlayTimeout = setTimeout(() => {
                        if (totalImages > 1) updateCarousel(currentIndex + 1);
                    }, 4500);
                }

                // Navigation functions
                function goToSlide(index) {
                    updateCarousel(index);
                }

                function nextSlide() {
                    updateCarousel(currentIndex + 1);
                }

                function prevSlide() {
                    updateCarousel(currentIndex - 1);
                }

                // Event listeners for buttons
                if (prevBtn) prevBtn.addEventListener('click', prevSlide);
                if (nextBtn) nextBtn.addEventListener('click', nextSlide);

                // Indicator click handling
                indicators.forEach((indicator, index) => {
                    indicator.addEventListener('click', () => goToSlide(index));
                });

                // Keyboard navigation
                document.addEventListener('keydown', (e) => {
                    if (!carouselContainer.closest('main')) return; // Only if carousel is visible
                    if (e.key === 'ArrowLeft') {
                        e.preventDefault();
                        prevSlide();
                    } else if (e.key === 'ArrowRight') {
                        e.preventDefault();
                        nextSlide();
                    }
                });

                // Touch/Swipe support
                const carouselMain = carouselContainer.querySelector('.carousel-main');
                if (carouselMain) {
                    carouselMain.addEventListener('touchstart', (e) => {
                        touchStartX = e.changedTouches[0].screenX;
                    }, false);

                    carouselMain.addEventListener('touchend', (e) => {
                        touchEndX = e.changedTouches[0].screenX;
                        handleSwipe();
                    }, false);

                    function handleSwipe() {
                        const swipeThreshold = 50;
                        const diff = touchStartX - touchEndX;

                        if (Math.abs(diff) > swipeThreshold) {
                            if (diff > 0) {
                                // Swiped left - show next
                                nextSlide();
                            } else {
                                // Swiped right - show previous
                                prevSlide();
                            }
                        }
                    }
                }

                // Stop auto-play on mouse enter
                carouselContainer.addEventListener('mouseenter', () => {
                    clearTimeout(autoPlayTimeout);
                });

                // Resume auto-play on mouse leave
                carouselContainer.addEventListener('mouseleave', () => {
                    autoPlayTimeout = setTimeout(() => {
                        if (totalImages > 1) updateCarousel(currentIndex + 1);
                    }, 4500);
                });

                // Initial auto-play start
                if (totalImages > 1) {
                    autoPlayTimeout = setTimeout(() => {
                        updateCarousel(currentIndex + 1);
                    }, 4500);
                }
            })();
        </script>

        <!-- Campground Details -->
        <% const reviewCount = campground.reviews.length; %>
        <% const reviewLabel = reviewCount === 1 ? 'review' : 'reviews'; %>
        <% const avgRating = reviewCount > 0 ? (campground.reviews.reduce((sum, r) => sum + r.rating, 0) / reviewCount).toFixed(1) : null; %>
        <div class="detail-info-box">
            <div class="detail-info-title">
                <div>
                    <h2 class="mb-1"><%= campground.title%></h2>
                    <div class="d-flex gap-2 mb-2 flex-wrap">
                        <span class="badge bg-success">
                            <i class="bi bi-patch-check-fill me-1"></i>Verified
                        </span>
                        <% if(reviewCount > 0) { %>
                        <span class="badge bg-warning text-dark">
                            <i class="bi bi-star-fill me-1"></i><%= avgRating %> (<%= reviewCount %> <%= reviewLabel %>)
                        </span>
                        <% } %>
                    </div>
                </div>
                <div class="detail-price">
                    <span class="detail-price-meta">Rs. <span class="detail-price-unit">/night</span></span>
                    <span class="detail-price-amount"><%= campground.price %></span>
                </div>
            </div>

            <p class="card-text mb-3"><%= campground.description%></p>

            <!-- Meta Information -->
            <div class="detail-meta">
                <div class="detail-meta-item">
                    <div class="detail-meta-icon" aria-hidden="true">
                        <i class="bi bi-geo-alt-fill"></i>
                    </div>
                    <div class="detail-meta-text">
                        <h6>Location</h6>
                        <p><%= campground.location%></p>
                    </div>
                </div>

                <div class="detail-meta-item">
                    <div class="detail-meta-icon" aria-hidden="true">
                        <i class="bi bi-globe2"></i>
                    </div>
                    <div class="detail-meta-text">
                        <h6>Country</h6>
                        <p><%= campground.country%></p>
                    </div>
                </div>

                <div class="detail-meta-item">
                    <div class="detail-meta-icon" aria-hidden="true">
                        <i class="bi bi-person-circle"></i>
                    </div>
                    <div class="detail-meta-text">
                        <h6>Host</h6>
                        <p><%= campground.author ? campground.author.username : 'Sahil' %></p>
                    </div>
                </div>

                <div class="detail-meta-item">
                    <div class="detail-meta-icon" aria-hidden="true">
                        <i class="bi bi-star"></i>
                    </div>
                    <div class="detail-meta-text">
                        <h6>Reviews</h6>
                        <p><%= reviewCount %> <%= reviewLabel %></p>
                    </div>
                </div>
            </div>

            <div class="map-label mt-4">
                <i class="bi bi-map me-2"></i>Location map
            </div>
            <div class="map-shell detail-map-shell">
                <div class="map-skeleton" aria-hidden="true"></div>
                <div id="map" class="map-panel detail-map marketplace-map"></div>
            </div>

            <!-- Edit/Delete Actions for Owner -->
            <% if(currentUser && campground.author && campground.author.equals(currentUser._id)) { %>
            <div class="d-flex gap-2 mt-4 pt-3 border-top">
                <a class="btn btn-info flex-grow-1" href="/campgrounds/<%=campground._id%>/edit">
                    <i class="fas fa-edit me-2"></i>Edit Campground
                </a>
                <form action="/campgrounds/<%=campground._id%>?_method=DELETE" method="POST" class="flex-grow-1">
                    <button class="btn btn-danger w-100">
                        <i class="fas fa-trash me-2"></i>Delete
                    </button>
                </form>
            </div>
            <% } %>
        </div>
    </div>

    <!-- Right Column - Reviews and Form -->
    <div class="col-lg-5">
        <!-- Review Form -->
        <% if(currentUser){ %>
        <div class="form-section">
            <h3 class="form-section-title mb-3">Share Your Experience</h3>
            
            <form action="/campgrounds/<%=campground._id%>/reviews" method="POST" class="validated-form" novalidate>
                <!-- Star Rating -->
                <div class="mb-4">
                    <label class="form-label mb-3">
                        <i class="fas fa-star text-warning me-2"></i>Your Rating*
                    </label>
                    <fieldset class="starability-basic">
                        <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
                        <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                        <label for="first-rate1" title="Terrible">1 star</label>
                        <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                        <label for="first-rate2" title="Not good">2 stars</label>
                        <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                        <label for="first-rate3" title="Average">3 stars</label>
                        <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                        <label for="first-rate4" title="Very good">4 stars</label>
                        <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                        <label for="first-rate5" title="Amazing">5 stars</label>
                    </fieldset>
                </div>

                <!-- Review Text -->
                <div class="form-group-vertical mb-4">
                    <label class="form-label" for="body">
                        <i class="fas fa-pen text-success me-1"></i>Your Review*
                    </label>
                    <textarea class="form-control" name="review[body]" id="body" rows="4" 
                        placeholder="Share your camping experience..." required></textarea>
                    <div class="valid-feedback">
                        <i class="fas fa-check me-1"></i>Looks good!
                    </div>
                </div>

                <button class="btn btn-success w-100" type="submit">
                    <i class="fas fa-paper-plane me-2"></i>Submit Review
                </button>
            </form>
        </div>
        <% } else { %>
        <div class="alert alert-info">
            <h5 class="alert-heading">
                <i class="fas fa-sign-in-alt me-2"></i>Sign in to review
            </h5>
            <p class="mb-0">Please <a href="/login" class="alert-link fw-bold">sign in</a> or <a href="/register" class="alert-link fw-bold">create an account</a> to leave a review.</p>
        </div>
        <% } %>

        <!-- Reviews List -->
        <div class="mt-5">
            <h3 class="mb-4">
                <i class="fas fa-comments text-primary me-2"></i>Reviews (<%= campground.reviews.length %>)
            </h3>

            <% if(campground.reviews.length === 0) { %>
            <div class="alert alert-secondary text-center py-4">
                <i class="fas fa-inbox fa-2x mb-3 d-block text-muted"></i>
                <p class="text-muted mb-0">No reviews yet. Be the first to share your experience!</p>
            </div>
            <% } else { %>
                <% for(let review of campground.reviews) { %>
                <div class="review-card stagger-item">
                    <div class="review-header">
                        <div>
                            <h6 class="review-author mb-1">
                                <i class="fas fa-user-circle me-1 text-primary"></i><%= review.author.username %>
                            </h6>
                            <p class="stars mb-2">
                                <% for(let i = 0; i < review.rating; i++) { %>
                                    <i class="fas fa-star text-warning"></i>
                                <% } %>
                                <% for(let i = review.rating; i < 5; i++) { %>
                                    <i class="fas fa-star text-secondary"></i>
                                <% } %>
                                <span class="ms-2 badge bg-warning text-dark"><%= review.rating %>/5</span>
                            </p>
                        </div>
                        <span class="review-date">
                            <i class="fas fa-calendar-alt me-1"></i>Recently
                        </span>
                    </div>

                    <p class="review-text"><%= review.body %></p>

                    <% if(currentUser && review.author.equals(currentUser._id)) { %>
                    <div class="review-actions">
                        <form action="/campgrounds/<%=campground._id%>/reviews/<%=review._id%>?_method=DELETE" method="POST" style="display: inline;">
                            <button class="btn btn-danger btn-sm review-actions-btn" title="Delete this review">
                                <i class="fas fa-trash me-1"></i>Delete
                            </button>
                        </form>
                    </div>
                    <% } %>
                </div>
                <% } %>
            <% } %>
        </div>
    </div>
</div>

<script>
    window.campground = <%- JSON.stringify({
        _id: campground._id,
        title: campground.title,
        location: campground.location,
        country: campground.country,
        description: campground.description,
        geometry: campground.geometry
    }) %>;
    window.mapTilerApiKey = <%- JSON.stringify(mapTilerApiKey) %>;
</script>
<script>
    document.addEventListener('DOMContentLoaded', () => {
        const imageCarousel = document.getElementById('imageCarousel');
        if (imageCarousel && window.bootstrap && window.bootstrap.Carousel) {
            window.bootstrap.Carousel.getOrCreateInstance(imageCarousel, {
                interval: 4500,
                pause: 'hover',
                ride: 'carousel',
                touch: true,
                wrap: true
            });
        }
    });
</script>
<script src="/javascripts/showPageMap.js"></script>

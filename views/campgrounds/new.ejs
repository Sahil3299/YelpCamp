<% layout('layouts/boilerplate')%>

<div class="container-md py-5">
    <div class="mb-5">
        <h1 class="mb-2">
            <i class="fas fa-plus-circle text-success me-2"></i>Add New Campground
        </h1>
        <p class="text-muted">Share your favorite camping spot with the community</p>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="form-section">
                <h3 class="form-section-title mb-4">Campground Information</h3>
                
                <form action="/campgrounds" method="POST" novalidate class="validated-form">
                    <!-- Basic Information -->
                    <div class="form-row">
                        <div>
                            <label class="form-label" for="title">
                                <i class="fas fa-heading text-primary me-1"></i>Campground Title*
                            </label>
                            <input class="form-control" type="text" id="title" name="campground[title]" 
                                placeholder="e.g., Mountain Peak Lodge" required>
                            <div class="valid-feedback">
                                <i class="fas fa-check me-1"></i>Looks good!
                            </div>
                        </div>
                    </div>

                    <!-- Location Information -->
                    <div class="form-row">
                        <div>
                            <label class="form-label" for="location">
                                <i class="fas fa-map-pin text-primary me-1"></i>Location*
                            </label>
                            <div class="location-search" data-location-search>
                                <div class="location-search-input">
                                    <input class="form-control" type="text" id="location" name="campground[location]"
                                        placeholder="Search an address, city, park, or landmark" autocomplete="off" required>
                                    <button class="location-current-btn" type="button" data-current-location title="Use current location" aria-label="Use current location">
                                        <i class="fas fa-location-crosshairs"></i>
                                    </button>
                                </div>
                                <div class="location-suggestions" data-location-suggestions></div>
                                <small class="text-muted" data-location-status>
                                    <i class="fas fa-info-circle me-1"></i>Choose a precise place so campers can find it on the map.
                                </small>
                            </div>
                            <div class="valid-feedback">
                                <i class="fas fa-check me-1"></i>Looks good!
                            </div>
                        </div>

                        <div>
                            <label class="form-label" for="country">
                                <i class="fas fa-globe text-primary me-1"></i>Country*
                            </label>
                            <input class="form-control" type="text" id="country" name="campground[country]" 
                                placeholder="e.g., India" required>
                            <div class="valid-feedback">
                                <i class="fas fa-check me-1"></i>Looks good!
                            </div>
                        </div>
                    </div>

                    <!-- Price -->
                    <div class="form-row">
                        <div>
                            <label class="form-label" for="price">
                                <i class="fas fa-dollar-sign text-primary me-1"></i>Price Per Night*
                            </label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input type="text" class="form-control" id="price" placeholder="0.00" 
                                    name="campground[price]" required>
                                <span class="input-group-text">/night</span>
                            </div>
                            <div class="valid-feedback">
                                <i class="fas fa-check me-1"></i>Looks good!
                            </div>
                        </div>
                    </div>

                    <!-- Description -->
                    <div class="form-group-vertical">
                        <label class="form-label" for="description">
                            <i class="fas fa-pen-fancy text-primary me-1"></i>Description*
                        </label>
                        <textarea class="form-control" id="description" name="campground[description]" 
                            rows="5" placeholder="Describe your campground. What makes it special? What amenities are available?" 
                            required></textarea>
                        <small class="text-muted">
                            <i class="fas fa-info-circle me-1"></i>Provide detailed information to help other campers
                        </small>
                        <div class="valid-feedback">
                            <i class="fas fa-check me-1"></i>Looks good!
                        </div>
                    </div>

                    <!-- Images Section -->
                    <div class="border-top pt-4 mt-4">
                        <h5 class="mb-3">
                            <i class="fas fa-images text-primary me-2"></i>Images
                        </h5>

                        <div class="form-group-vertical">
                            <label class="form-label" for="image">
                                <i class="fas fa-image text-primary me-1"></i>Main Image URL*
                            </label>
                            <input class="form-control" type="text" id="image" name="campground[image]" 
                                placeholder="https://example.com/image.jpg" required>
                            <small class="text-muted">
                                <i class="fas fa-info-circle me-1"></i>This will be displayed on campground cards
                            </small>
                            <div class="valid-feedback">
                                <i class="fas fa-check me-1"></i>Looks good!
                            </div>
                        </div>

                        <div class="form-group-vertical">
                            <label class="form-label" for="images">
                                <i class="fas fa-images text-primary me-1"></i>Additional Images (Optional)
                            </label>
                            <textarea class="form-control" id="images" name="campground[images]" rows="3"
                                placeholder="https://example.com/image1.jpg, https://example.com/image2.jpg, https://example.com/image3.jpg"></textarea>
                            <small class="text-muted">
                                <i class="fas fa-info-circle me-1"></i>Enter URLs separated by commas
                            </small>
                        </div>
                    </div>

                    <!-- Form Actions -->
                    <div class="d-flex gap-3 mt-5">
                        <button class="btn btn-success btn-lg" type="submit">
                            <i class="fas fa-check me-2"></i>Add Campground
                        </button>
                        <a href="/campgrounds" class="btn btn-outline-secondary btn-lg">
                            <i class="fas fa-times me-2"></i>Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script src="/javascripts/locationAutocomplete.js"></script>

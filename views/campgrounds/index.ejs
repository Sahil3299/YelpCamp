<% layout('layouts/boilerplate')%>

<section class="campgrounds-page py-3 py-md-4">
<div class="page-kicker">Explore the collection</div>
<div class="campgrounds-heading product-page-header mb-5">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div>
            <h1 class="mb-1">Campgrounds</h1>
            <p class="text-muted mb-0">Browse <%= campgrounds.length %> spots from our community.</p>
        </div>
        <a href="/campgrounds/new" class="btn btn-theme btn-theme-primary btn-lg" title="Add a new campground">
            <i class="fas fa-plus me-2"></i>Share a spot
        </a>
    </div>
</div>

<section class="map-section mb-5">
    <div class="map-toolbar">
        <div>
            <div class="map-label">
                <i class="fas fa-map me-2"></i>Map view
            </div>
            <p class="text-muted small mb-0">Explore every campground on one interactive map.</p>
        </div>
        <span class="map-count"><%= campgrounds.length %> places</span>
    </div>
    <div class="map-shell">
        <div class="map-skeleton" aria-hidden="true"></div>
        <div id="cluster-map" class="map-panel marketplace-map"></div>
    </div>
</section>

<% if(campgrounds.length === 0) {%>
<div class="alert alert-info animate-fade-in-up" role="alert">
    <div class="text-center py-5">
        <i class="fas fa-inbox fa-3x text-info mb-3 d-block"></i>
        <h5>No campgrounds yet</h5>
        <p class="mb-3">Be the first to add a campground to our community!</p>
        <a href="/campgrounds/new" class="btn btn-theme btn-theme-primary">
            <i class="fas fa-plus me-2"></i>Add First Campground
        </a>
    </div>
</div>
<% } else {%>
<div class="grid-cards">
    <% for (let campground of campgrounds){%>
    <div class="campground-card stagger-item hover-lift">
        <div class="campground-card-image image-hover-overlay">
            <% const imageUrl = campground.thumbnail || '/images/yelpcamp.png'; %>
            <img src="<%= imageUrl %>" alt="<%= campground.title %>" class="w-100 h-100" style="object-fit: cover;" loading="lazy">
            <% if(campground.author) {%>
            <span class="campground-card-badge"><i class="fas fa-check me-1"></i>Verified</span>
            <% } %>
        </div>
        <div class="campground-card-body">
            <h5 class="campground-card-title"><%= campground.title %></h5>
            <p class="campground-card-description">
                <% if(campground.description && campground.description.length > 80) {%>
                    <%= campground.description.substring(0, 80) %>...
                <% } else {%>
                    <%= campground.description %>
                <% } %>
            </p>
            
            <div class="campground-card-location">
                <i class="fas fa-map-marker-alt"></i>
                <span>
                    <%= campground.location %><% if(campground.country) { %>, <%= campground.country %><% } %>
                </span>
            </div>
            
            <div class="campground-card-footer">
                <div>
                    <div class="campground-card-price">
                        Rs. <%= campground.price %><small>/night</small>
                    </div>
                </div>
                <a href="/campgrounds/<%=campground._id%>" class="btn btn-theme btn-theme-secondary btn-sm campground-card-btn" title="View details">
                    <i class="fas fa-arrow-right me-1"></i>View
                </a>
            </div>
        </div>
    </div>
    <% }%>
</div>
<% }%>
</section>

<script>
    window.campgrounds = <%- JSON.stringify(campgrounds.map(campground => ({
        _id: campground._id,
        title: campground.title,
        location: campground.location,
        country: campground.country,
        description: campground.description,
        image: campground.thumbnail,
        geometry: campground.geometry
    }))) %>;
    window.mapTilerApiKey = <%- JSON.stringify(mapTilerApiKey) %>;
</script>
<script src="/javascripts/clusterMap.js"></script>

<% layout('layouts/boilerplate')%>

<div class="container-md py-5">
    <div class="mb-5">
        <h1 class="mb-2">
            <i class="fas fa-edit text-info me-2"></i>Edit Campground
        </h1>
        <p class="text-muted">Update your campground information</p>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="form-section">
                <h3 class="form-section-title mb-4">Campground Information</h3>
                
                <form action="/campgrounds/<%=campground._id%>?_method=PUT" method="POST" novalidate class="validated-form">
                    <!-- Basic Information -->
                    <div class="form-row">
                        <div>
                            <label class="form-label" for="title">
                                <i class="fas fa-heading text-info me-1"></i>Campground Title*
                            </label>
                            <input class="form-control" type="text" id="title" name="campground[title]"
                                value="<%=campground.title %>" required>
                            <div class="valid-feedback">
                                <i class="fas fa-check me-1"></i>Looks good!
                            </div>
                        </div>
                    </div>

                    <!-- Location Information -->
                    <div class="form-row">
                        <div>
                            <label class="form-label" for="location">
                                <i class="fas fa-map-pin text-info me-1"></i>Location/City*
                            </label>
                            <input class="form-control" type="text" id="location" name="campground[location]"
                                value="<%=campground.location %>" required>
                            <div class="valid-feedback">
                                <i class="fas fa-check me-1"></i>Looks good!
                            </div>
                        </div>

                        <div>
                            <label class="form-label" for="country">
                                <i class="fas fa-globe text-info me-1"></i>Country*
                            </label>
                            <input class="form-control" type="text" id="country" name="campground[country]"
                                value="<%=campground.country %>" required>
                            <div class="valid-feedback">
                                <i class="fas fa-check me-1"></i>Looks good!
                            </div>
                        </div>
                    </div>

                    <!-- Price -->
                    <div class="form-row">
                        <div>
                            <label class="form-label" for="price">
                                <i class="fas fa-dollar-sign text-info me-1"></i>Price Per Night*
                            </label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input type="text" class="form-control" id="price" placeholder="0.00"
                                    name="campground[price]" value="<%=campground.price %>" required>
                                <span class="input-group-text">/night</span>
                            </div>
                            <div class="valid-feedback">
                                <i class="fas fa-check me-1"></i>Looks good!
                            </div>
                        </div>
                    </div>

                    <!-- Description -->
                    <div class="form-group-vertical">
                        <label class="form-label" for="description">
                            <i class="fas fa-pen-fancy text-info me-1"></i>Description*
                        </label>
                        <textarea class="form-control" id="description" name="campground[description]" 
                            rows="5" required><%= campground.description%></textarea>
                        <small class="text-muted">
                            <i class="fas fa-info-circle me-1"></i>Provide detailed information to help other campers
                        </small>
                        <div class="valid-feedback">
                            <i class="fas fa-check me-1"></i>Looks good!
                        </div>
                    </div>

                    <!-- Images Section -->
                    <div class="border-top pt-4 mt-4">
                        <h5 class="mb-3">
                            <i class="fas fa-images text-info me-2"></i>Images
                        </h5>

                        <div class="form-group-vertical">
                            <label class="form-label" for="image">
                                <i class="fas fa-image text-info me-1"></i>Main Image URL*
                            </label>
                            <input class="form-control" type="text" id="image" name="campground[image]"
                                value="<%=campground.image %>" required>
                            <small class="text-muted">
                                <i class="fas fa-info-circle me-1"></i>This will be displayed on campground cards
                            </small>
                            <div class="valid-feedback">
                                <i class="fas fa-check me-1"></i>Looks good!
                            </div>
                        </div>

                        <div class="form-group-vertical">
                            <label class="form-label" for="images">
                                <i class="fas fa-images text-info me-1"></i>Additional Images (Optional)
                            </label>
                            <textarea class="form-control" id="images" name="campground[images]" rows="3"><%=campground.images ? campground.images.join(', ') : '' %></textarea>
                            <small class="text-muted">
                                <i class="fas fa-info-circle me-1"></i>Enter URLs separated by commas
                            </small>
                        </div>
                    </div>

                    <!-- Form Actions -->
                    <div class="d-flex gap-3 mt-5">
                        <button class="btn btn-info btn-lg" type="submit">
                            <i class="fas fa-save me-2"></i>Update Campground
                        </button>
                        <a href="/campgrounds/<%= campground._id%>" class="btn btn-outline-secondary btn-lg">
                            <i class="fas fa-times me-2"></i>Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
<% layout('layouts/boilerplate')%>

<div class="container-md py-5">
    <div class="mb-5">
        <h1 class="mb-2">
            <i class="fas fa-edit text-info me-2"></i>Edit Campground
        </h1>
        <p class="text-muted">Update your campground information</p>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="form-section">
                <h3 class="form-section-title mb-4">Campground Information</h3>
                
                <form action="/campgrounds/<%=campground._id%>?_method=PUT" method="POST" novalidate class="validated-form" enctype="multipart/form-data" data-upload-form>
                    <!-- Basic Information -->
                    <div class="form-row">
                        <div>
                            <label class="form-label" for="title">
                                <i class="fas fa-heading text-info me-1"></i>Campground Title*
                            </label>
                            <input class="form-control" type="text" id="title" name="campground[title]"
                                value="<%=campground.title %>" required>
                            <div class="valid-feedback">
                                <i class="fas fa-check me-1"></i>Looks good!
                            </div>
                        </div>
                    </div>

                    <!-- Location Information -->
                    <div class="form-row">
                        <div>
                            <label class="form-label" for="location">
                                <i class="fas fa-map-pin text-info me-1"></i>Location*
                            </label>
                            <div class="location-search" data-location-search>
                                <div class="location-search-input">
                                    <input class="form-control" type="text" id="location" name="campground[location]"
                                        value="<%=campground.location %>" autocomplete="off" required>
                                    <button class="location-current-btn" type="button" data-current-location title="Use current location" aria-label="Use current location">
                                        <i class="fas fa-location-crosshairs"></i>
                                    </button>
                                </div>
                                <div class="location-suggestions" data-location-suggestions></div>
                                <small class="text-muted" data-location-status>
                                    <i class="fas fa-info-circle me-1"></i>Update this if the pin should move on the map.
                                </small>
                            </div>
                            <div class="valid-feedback">
                                <i class="fas fa-check me-1"></i>Looks good!
                            </div>
                        </div>

                        <div>
                            <label class="form-label" for="country">
                                <i class="fas fa-globe text-info me-1"></i>Country*
                            </label>
                            <input class="form-control" type="text" id="country" name="campground[country]"
                                value="<%=campground.country %>" required>
                            <div class="valid-feedback">
                                <i class="fas fa-check me-1"></i>Looks good!
                            </div>
                        </div>
                    </div>

                    <!-- Price -->
                    <div class="form-row">
                        <div>
                            <label class="form-label" for="price">
                                <i class="fas fa-dollar-sign text-info me-1"></i>Price Per Night*
                            </label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input type="text" class="form-control" id="price" placeholder="0.00"
                                    name="campground[price]" value="<%=campground.price %>" required>
                                <span class="input-group-text">/night</span>
                            </div>
                            <div class="valid-feedback">
                                <i class="fas fa-check me-1"></i>Looks good!
                            </div>
                        </div>
                    </div>

                    <!-- Description -->
                    <div class="form-group-vertical">
                        <label class="form-label" for="description">
                            <i class="fas fa-pen-fancy text-info me-1"></i>Description*
                        </label>
                        <textarea class="form-control" id="description" name="campground[description]" 
                            rows="5" required><%= campground.description%></textarea>
                        <small class="text-muted">
                            <i class="fas fa-info-circle me-1"></i>Provide detailed information to help other campers
                        </small>
                        <div class="valid-feedback">
                            <i class="fas fa-check me-1"></i>Looks good!
                        </div>
                    </div>

                    <!-- Images Section -->
                    <div class="border-top pt-4 mt-4">
                        <h5 class="mb-3">
                            <i class="fas fa-images text-info me-2"></i>Images
                        </h5>

                        <% if (campground.images && campground.images.length > 0) { %>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Current Images</label>
                            <p class="text-muted small mb-2">Check images you want to delete.</p>
                            <div class="row g-3">
                                <% campground.images.forEach((img, index) => { %>
                                <div class="col-6 col-md-4">
                                    <div class="position-relative border rounded overflow-hidden">
                                        <img src="<%= img.thumbnail || img.url.replace('/upload/', '/upload/w_200/') %>"
                                            alt="Campground image <%= index + 1 %>" class="w-100" style="height: 140px; object-fit: cover;">
                                        <div class="form-check position-absolute" style="top: 6px; left: 6px; background: rgba(255,255,255,0.85); border-radius: 4px; padding: 2px 6px;">
                                            <input class="form-check-input" type="checkbox"
                                                name="deleteImages[]" value="<%= img.filename %>"
                                                id="deleteImage-<%= index %>">
                                            <label class="form-check-label small" for="deleteImage-<%= index %>">Delete</label>
                                        </div>
                                    </div>
                                </div>
                                <% }) %>
                            </div>
                        </div>
                        <% } %>

                        <div class="form-group-vertical">
                            <label class="form-label" for="image">
                                <i class="fas fa-camera text-info me-1"></i>Upload New Images
                            </label>
                            <input class="form-control" type="file" id="image" name="image"
                                multiple accept="image/*">
                            <small class="text-muted">
                                <i class="fas fa-info-circle me-1"></i>Add more images (max 6). Accepted formats: jpeg, png, webp.
                            </small>
                            <div id="file-feedback" class="mt-2 text-muted small"></div>
                            <div class="upload-status mt-3" data-upload-status role="status" aria-live="polite" hidden></div>
                        </div>
                    </div>

                    <!-- Form Actions -->
                    <div class="d-flex gap-3 mt-5">
                        <button class="btn btn-theme btn-theme-secondary btn-lg" type="submit" data-upload-submit>
                            <i class="fas fa-save me-2"></i>Update Campground
                        </button>
                        <a href="/campgrounds/<%= campground._id%>" class="btn btn-theme btn-theme-outline btn-theme-neutral btn-lg">
                            <i class="fas fa-times me-2"></i>Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script src="/javascripts/locationAutocomplete.js"></script>
<script>
    document.getElementById('image').addEventListener('change', function(e) {
        const feedback = document.getElementById('file-feedback');
        const count = e.target.files.length;
        if (count === 0) {
            feedback.textContent = '';
        } else {
            feedback.textContent = count + ' new image' + (count > 1 ? 's' : '') + ' selected';
        }
    });
</script>
